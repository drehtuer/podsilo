# The security policy page, rendered from SECURITY.md by scripts/build-docs.sh at
# build time. SECURITY.md is the single source — that filename is what GitHub's
# Security tab reads — and a generated file in git is a file that drifts.
docs/modules/ROOT/pages/security.adoc

# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Local Gradle/Android SDK config — machine-specific, never shared
local.properties

# Android Studio / IntelliJ
.idea/*
!.idea/copyright/
!.idea/codeStyles/
*.iml
*.ipr
*.iws
.navigation/
captures/
.externalNativeBuild/
.cxx/

# Signing material — never committed. Everything lives in one directory now
# (keystore/): the release .jks, the debug .jks, and the keystore.properties
# that holds the passwords for both. Ignoring the directory rather than the file
# types is what makes that a rule instead of a habit — a key dropped in there
# under any name is covered.
keystore/
# The patterns below are kept as a backstop for signing material that lands
# anywhere else, which is the mistake worth catching.
*.jks
*.keystore
keystore.properties

# Secrets
.env
!.env.example

# OS cruft
.DS_Store
Thumbs.db
