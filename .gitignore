# The security policy page, rendered from SECURITY.md by scripts/build-docs.sh at
# build time. SECURITY.md is the single source — that filename is what GitHub's
# Security tab reads — and a generated file in git is a file that drifts.
docs/modules/ROOT/pages/security.adoc

# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Local Gradle/Android SDK config — machine-specific, never shared
local.properties

# Android Studio / IntelliJ
.idea/*
!.idea/copyright/
!.idea/codeStyles/
*.iml
*.ipr
*.iws
.navigation/
captures/
.externalNativeBuild/
.cxx/

# Keystores — never commit signing material
*.jks
*.keystore
# ...nor the passwords that open them (app/build.gradle.kts reads this file)
keystore.properties

# Secrets
.env
!.env.example

# OS cruft
.DS_Store
Thumbs.db
