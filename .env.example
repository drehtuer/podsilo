# SPDX-License-Identifier: GPL-3.0-or-later
#
# Copy to `.env` (gitignored) and adjust. Used by .devcontainer/docker-compose.yml
# for the disposable opodsync test server, and by :core:gpodder's opt-in
# integration test.
#
# These are TEST credentials for a throwaway local server. Never put real
# Nextcloud credentials here — CLAUDE.md §4: "No secrets in the image, in
# devcontainer.json, or in git."

# Host port the opodsync container publishes on.
OPODSYNC_PORT=8080

# Test user to create at http://localhost:8080/register.php after first boot.
OPODSYNC_USER=podsilo
OPODSYNC_PASSWORD=podsilo-test-password

# Base URL :core:gpodder's integration test points at. Leave UNSET to skip that
# test entirely (the default — Tier 1 `./gradlew test` must never need a server).
# The dev container runs with --network=host, so it shares the host's network
# namespace and localhost reaches the published port directly. Under ordinary
# bridge networking use http://<host-ip>:8080 from inside the container instead.
# PODSILO_OPODSYNC_URL=http://localhost:8080
