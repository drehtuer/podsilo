<!--
  The Podsilo mark: a silo, an episode dropping into it, and the pool that collects at the bottom.

  That is the app's whole idea in one shape (README: "episodes flow in from your feeds, pool in a
  folder you picked, and are consumed by whatever audio player you actually like"), and it avoids
  the two obvious clichés — a microphone, which this app deliberately is not about, and an RSS
  wave, which every feed reader already uses.

  GEOMETRY IS CONSTRAINED, NOT ARBITRARY. An adaptive icon is a 108x108dp canvas of which launchers
  may mask anything outside the central 66dp circle, and they crop to circles, squircles and
  rounded squares depending on the device. Everything here sits inside that circle: the widest
  point is the silo's bottom corner at (72,80), which is 31.6dp from the centre. Drawn to the edges
  it would lose its own outline on a circular launcher.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      The silo: a domed top over a straight body with a softened base. Stroked rather than filled,
      so the mark reads as a container with something inside it rather than as a solid blob.
    -->
    <path
        android:fillColor="#00000000"
        android:pathData="M36,46 A18,18 0 0 1 72,46 L72,75 A5,5 0 0 1 67,80 L41,80 A5,5 0 0 1 36,75 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- The episode arriving. Points down, into the silo — the app catches, it does not broadcast. -->
    <path
        android:fillColor="#00000000"
        android:pathData="M54,34 L54,50"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round" />
    <path
        android:fillColor="#00000000"
        android:pathData="M47,43 L54,50 L61,43"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!--
      What has already collected. Inset by the stroke width so it reads as being *inside* the silo
      rather than welded to its wall, and stopped well short of the top so the silo is visibly not
      full — the point of the app is that the author decides what goes in.
    -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M39,59 L69,59 L69,73 A4,4 0 0 1 65,77 L43,77 A4,4 0 0 1 39,73 Z" />
</vector>
