<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <!--
      Android 13+ themed icons. The launcher recolours this layer to the user's wallpaper palette,
      so it must be the mark alone on transparency — the same foreground, whose colour is discarded.
      Omitting it does not break anything; it just opts the app out of themed icons for no reason.
    -->
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
