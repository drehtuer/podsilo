<!--
  The brand mark, all white, for the accent field and dark surfaces (docs/logo.md §1: "On the accent
  field or on ink, the whole mark is #ffffff"). Converted from
  `assets/logos/podsilo-mark-inverse.svg`.

  This exists because the two-colour mark's vessel is ink #201E1D, which is invisible against the
  dark scheme's #14110F surface. `PodsiloMark` picks between the two by the theme's surface
  luminance rather than by a `-night` resource qualifier — the theme is a user preference in
  DataStore (docs/UI.md §12.7), so it can disagree with the system's night mode, and a qualifier
  would then serve a white mark onto a light surface.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M30,6 h40 v10 h-40 z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M36,24 h28 v10 h-28 z" />
    <path
        android:fillColor="#00000000"
        android:pathData="M18,42 V94 H82 V42"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="10" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M32,70 h36 v10 h-36 z" />
</vector>
