{
  // Podsilo dev container — plain Ubuntu 24.04 + JDK 17 + Android SDK + Claude Code.
  // No devcontainer "features" and no prebuilt vendor image on purpose: everything
  // this container needs is either an Ubuntu package, Google's command-line tools, or
  // Anthropic's native Claude Code binary.
  "name": "podsilo",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".",
    // Host networking during build — see the runArgs comment below. Without it every
    // `RUN apt-get`/`curl` step fails with "Could not connect ... connection timed
    // out" while the WSL2 host itself has perfectly good internet.
    "options": [
      "--network=host"
    ],
    // These four are BEST-EFFORT DEFAULTS — you should not need to change them on
    // a new machine, and changing them is not sufficient on its own anyway.
    //
    // The devcontainer CLI rewrites the container user's UID/GID at start to match
    // the host user (updateRemoteUserUID) but only chowns $HOME, so the named
    // volumes below keep the image's ownership. And /dev/kvm and the docker socket
    // arrive carrying the host's GIDs, whatever those are.
    //
    // post-create.sh therefore repairs all of it at runtime, where the real IDs
    // are actually knowable: it re-chowns the persisted directories to the current
    // user and aligns the kvm/docker groups to whatever owns those nodes. That is
    // what makes this container portable across hosts with different IDs.
    "args": {
      "USER_UID": "1000",
      "USER_GID": "1000",
      "KVM_GID": "993",
      "DOCKER_GID": "108"
    }
  },
  "workspaceFolder": "/workspaces/podsilo",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/podsilo,type=bind,consistency=cached",
  // Persist everything expensive to re-download or re-authenticate. The Android SDK
  // is installed by post-create.sh into its volume rather than baked into the image.
  // Paths are literal /home/dev/... — keep them in step with the USERNAME build arg.
  "mounts": [
    "source=podsilo-android-sdk,target=/opt/android-sdk,type=volume",
    "source=podsilo-gradle,target=/home/dev/.gradle,type=volume",
    "source=podsilo-android-user,target=/home/dev/.android,type=volume",
    // $CLAUDE_CONFIG_DIR — Claude Code's credentials, settings, and session
    // history. With CLAUDE_CONFIG_DIR set (see Dockerfile) `.claude.json` lives
    // inside this directory rather than at $HOME, so one volume covers the lot and
    // `/login` survives an image rebuild. The Claude Code *binary* lives under
    // ~/.local, so this mount cannot shadow it.
    //
    // Deliberately NOT a bind mount of the host's ~/.claude: that would share one
    // credentials and history file between host Claude Code and container Claude
    // Code, which both write to it. Cost is one `/login` inside the container.
    "source=podsilo-claude-config,target=/home/dev/.claude,type=volume",
    // $GH_CONFIG_DIR — `gh auth login`'s token and config, so authenticating to
    // GitHub also survives an image rebuild. Same rationale as the Claude volume.
    "source=podsilo-gh-config,target=/home/dev/.config/gh,type=volume",
    // Commit identity for Claude Code (and you) inside the container. Read-only —
    // nothing in here should be rewriting the host's git config.
    // Requires ~/.gitconfig to exist on the host: Docker silently creates a
    // *directory* for a missing bind source, which git then ignores. Drop this line
    // if you have no host git config.
    "source=${localEnv:HOME}/.gitconfig,target=/home/dev/.gitconfig,type=bind,readonly",
    // docker-outside-of-docker: the host's daemon socket, so the docker CLI in the
    // image drives the HOST daemon and any container it starts (opodsync, emulator)
    // is a sibling rather than a child. Needs DOCKER_GID above to match this
    // socket's group, or it is unreadable to the dev user.
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],
  "runArgs": [
    // --network=host.
    //
    // ORIGINALLY added because the host was on an IPv6-only access point and
    // Docker's default bridge is IPv4-only, so bridged containers had no route out
    // at all and every apt-get/curl in the build timed out. That is no longer the
    // reason: on the current machine (2026-07-31) the situation is reversed —
    // `curl -4 https://dl.google.com` returns 302 and `curl -6` fails outright.
    //
    // It is KEPT because it is independently useful, not because it is still
    // load-bearing for connectivity:
    //   - The opodsync test server (docker-compose.yml) comes up as a sibling
    //     container on the host daemon and is reachable at http://localhost:8080
    //     from in here with no host-IP lookup. docs/dev-environment.md §7 documents
    //     that address.
    //   - For Tier 3, under WSL2 mirrored networking the container's `localhost` is
    //     the Windows host, so a Windows-side `adb -a -P 5037 nodaemon server` is
    //     reachable at tcp:localhost:5037, again with no host-IP lookup.
    //
    // Consequences to remember:
    //   - No network isolation and no devcontainer port forwarding; anything the
    //     container listens on binds straight onto the host.
    //   - No container-to-container DNS for this container.
    // Plain bridge networking should work now; dropping this line means re-checking
    // both bullets above.
    "--network=host",
    // Hardware virtualisation for the in-container (Tier 2) emulator. Requires
    // Windows 11 + Docker Engine installed inside the WSL2 distro (not Docker
    // Desktop). Windows 11 enables nested virtualisation by default; add
    // `nestedVirtualization=true` to .wslconfig if /dev/kvm goes missing.
    // If `ls -l /dev/kvm` fails on the host, DELETE this line — otherwise the
    // container will not start at all. Tier 1 and Tier 3 do not need it.
    "--device=/dev/kvm"
  ],
  "remoteUser": "dev",
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "fwcd.kotlin",
        "vscjava.vscode-gradle",
        "editorconfig.editorconfig",
        "EditorConfig.EditorConfig",
        "github.vscode-github-actions",
        "GitHub.vscode-pull-request-github",
        "Anthropic.claude-code"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.eol": "\n"
      }
    }
  }
}
